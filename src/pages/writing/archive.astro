---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getWritingItems, type WritingItem } from '../../lib/writing';

const items = await getWritingItems();

// Group by year
const byYear: Record<number, WritingItem[]> = {};
for (const item of items) {
	const year = item.date ? new Date(item.date).getFullYear() : 0;
	if (!byYear[year]) byYear[year] = [];
	byYear[year].push(item);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Archive — ${SITE_TITLE}`} description="All writing by year." />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<p style="font-size: 0.85rem; color: rgb(var(--gray)); margin-bottom: 0.5rem;">
				<a href="/writing/" style="color: rgb(var(--gray)); text-decoration: none;">Writing</a> › Archive
			</p>
			<h1 style="font-size: 1.4rem; margin-bottom: 1.5rem;">Archive</h1>

			{years.map((year) => (
				<div class="archive-year">
					<h2>{year !== 0 ? year : 'Undated'}</h2>
					<ul class="post-list">
						{byYear[year].map((item) => (
							<li>
								<p class="post-meta">
									{item.date && <FormattedDate date={item.date} />}
								</p>
								<p class="post-title">
									<a href={item.href}>{item.title}</a>
								</p>
							</li>
						))}
					</ul>
				</div>
			))}
		</main>
		<Footer />
	</body>
</html>
