---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getWritingItems } from '../lib/writing';

const websiteSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"name": "Tim Dennis",
			"url": "https://www.tim-dennis.com",
			"description": SITE_DESCRIPTION,
			"author": { "@type": "Person", "name": "Tim Dennis" }
		},
		{
			"@type": "Person",
			"name": "Tim Dennis",
			"jobTitle": "Director, UCLA Library Data Science Center",
			"affiliation": {
				"@type": "EducationalOrganization",
				"name": "University of California, Los Angeles"
			},
			"url": "https://www.tim-dennis.com",
			"sameAs": [
				"https://orcid.org/0000-0001-6632-3812",
				"https://scholar.google.com/citations?user=RpiRBrAAAAAJ",
				"https://github.com/jt14den",
				"https://www.linkedin.com/in/jtimdennis/"
			],
			"knowsAbout": [
				"Open Science",
				"Research Data Management",
				"Research Data Infrastructure",
				"Data Governance",
				"Library Leadership"
			]
		}
	]
};

// Latest 6 published items, blog posts and notes combined
const recentItems = (await getWritingItems()).slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Tim Dennis | Research Data Infrastructure & Academic Library Leadership" description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<Header />
		<main id="main-content">
			<div class="home-intro">
				<p>
					I'm Tim Dennis. I've spent 26 years in the UC system building research data
					infrastructure that keeps running after the grant ends, after the staff
					turns over, after the priorities shift.
				</p>
				<p>
					I run the UCLA Library Data Science Center. This is where I write about what that
					work actually takes.
				</p>
			</div>

			<section class="home-section">
				<h2>Recent writing</h2>
				{recentItems.length > 0 ? (
					<ul class="post-list">
						{recentItems.map((item) => (
							<li>
								<p class="post-meta">
									{item.date && <FormattedDate date={item.date} />}
									{item.type === 'crosspost' && (
										<span class="type-badge crosspost">Crosspost</span>
									)}
									{item.type === 'linkpost' && (
										<span class="type-badge linkpost">Link</span>
									)}
								</p>
								<p class="post-title">
									<a href={item.href}>{item.title}</a>
								</p>
								{item.description && (
									<p class="post-desc">{item.description}</p>
								)}
							</li>
						))}
					</ul>
				) : (
					<p style="color: rgb(var(--gray)); font-size: 0.95rem;">No posts yet.</p>
				)}
				<p style="margin-top: 1rem; font-size: 0.9rem;">
					<a href="/writing/">All writing →</a>
				</p>
			</section>

			<section class="home-section">
				<h2>Work</h2>
				<div class="home-links">
					<a href="/programs/">Programs</a>
					<a href="/cv/">CV</a>
					<a href="/scholarship/">Scholarship</a>
					<a href="/talks-grants/">Talks & Grants</a>
					<a href="/case-studies/">Case Studies</a>
					<a href="/impact/">Impact</a>
					<a href="/governance/">Governance</a>
					<a href="/bibliography">Bibliography</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
