---
import BaseLayout from '../layouts/BaseLayout.astro';
import { load as loadYaml } from 'js-yaml';
import cvYamlRaw from '../data/cv.yaml?raw';

interface CvEntry {
	// Experience / NormalEntry fields
	company?: string;
	position?: string;
	name?: string;
	location?: string;
	summary?: string;
	start_date?: string;
	end_date?: string;
	date?: string;
	highlights?: string[];
	// OneLineEntry fields
	label?: string;
	details?: string;
	// PublicationEntry fields
	title?: string;
	authors?: string[];
	journal?: string;
	doi?: string;
	// BulletEntry fields
	bullet?: string;
	// EducationEntry fields
	institution?: string;
	area?: string;
	degree?: string;
}

interface CvData {
	cv: {
		name: string;
		headline?: string;
		location?: string;
		email?: string;
		website?: string;
		social_networks?: { network: string; username: string }[];
		sections: Record<string, CvEntry[]>;
	};
}

const { cv } = loadYaml(cvYamlRaw) as CvData;

// RenderCV content supports lightweight markdown (bold/italic) — render it as HTML.
function md(text?: string): string {
	if (!text) return '';
	return text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/\*(.+?)\*/g, '<em>$1</em>');
}

const MONTHS = [
	'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
];

function formatDate(d?: string): string {
	if (!d) return '';
	if (d === 'present') return 'Present';
	const [y, m] = d.split('-');
	if (!m) return y;
	return `${MONTHS[parseInt(m, 10) - 1]} ${y}`;
}

function dateRange(entry: CvEntry): string {
	if (entry.date) return formatDate(entry.date);
	const start = formatDate(entry.start_date);
	const end = formatDate(entry.end_date);
	if (start && end) return `${start} – ${end}`;
	return start || end || '';
}

const NETWORK_URL: Record<string, (username: string) => string> = {
	LinkedIn: (u) => `https://linkedin.com/in/${u}`,
	GitHub: (u) => `https://github.com/${u}`,
	ORCID: (u) => `https://orcid.org/${u}`,
};

const sections = cv.sections;
const experience = sections.experience ?? [];
const systemwideLeadership = sections.systemwide_leadership ?? [];
const grantsAndFunding = sections.grants_and_funding ?? [];
const teaching = sections.teaching_and_program_building ?? [];
const professionalService = sections.professional_service ?? [];
const publications = sections.publications ?? [];
const presentations = sections.selected_presentations ?? [];
const education = sections.education ?? [];
const technicalSkills = sections.technical_skills ?? [];
---

<BaseLayout
	title="CV"
	description={`Curriculum vitae for ${cv.name}${cv.headline ? `, ${cv.headline}` : ''}.`}
>
	<div class="cv-header">
		<h1>{cv.name}</h1>
		{cv.headline && <p class="cv-headline">{cv.headline}</p>}
		<p class="cv-contact">
			{cv.location}
			{cv.email && (
				<>
					{' '}· <a href={`mailto:${cv.email}`}>{cv.email}</a>
				</>
			)}
			{cv.website && (
				<>
					{' '}· <a href={cv.website}>{cv.website.replace(/^https?:\/\//, '')}</a>
				</>
			)}
			{(cv.social_networks ?? []).map((s) => (
				<>
					{' '}·{' '}
					<a href={NETWORK_URL[s.network]?.(s.username) ?? '#'} target="_blank" rel="noopener">
						{s.network === 'ORCID' ? `ORCID ${s.username}` : `${s.network}: ${s.username}`}
					</a>
				</>
			))}
		</p>
		<p class="cv-pdf">
			<a href="/tim_dennis_cv.pdf" target="_blank" rel="noopener">Download PDF version</a>
		</p>
	</div>

	{experience.length > 0 && (
		<section>
			<h2>Experience</h2>
			{experience.map((e) => (
				<div class="cv-entry">
					<div class="cv-entry-header">
						<strong>{e.position}, {e.company}</strong>
						<span class="cv-date">{dateRange(e)}</span>
					</div>
					{e.location && <p class="cv-org">{e.location}</p>}
					{e.summary && <p set:html={md(e.summary)} />}
					{e.highlights && e.highlights.length > 0 && (
						<ul class="cv-highlights">
							{e.highlights.map((h) => <li set:html={md(h)} />)}
						</ul>
					)}
				</div>
			))}
		</section>
	)}

	{education.length > 0 && (
		<section>
			<h2>Education</h2>
			{education.map((ed) => (
				<div class="cv-entry">
					<div class="cv-entry-header">
						<strong>{ed.degree}, {ed.area}</strong>
					</div>
					<p class="cv-org">
						{ed.institution}
						{ed.location && `, ${ed.location}`}
					</p>
					{ed.summary && <p set:html={md(ed.summary)} />}
				</div>
			))}
		</section>
	)}

	{systemwideLeadership.length > 0 && (
		<section>
			<h2>Cross-institutional &amp; systemwide leadership</h2>
			<ul class="item-list">
				{systemwideLeadership.map((e) => (
					<li class="cv-entry">
						<div class="cv-entry-header">
							<strong>{e.name}</strong>
							<span class="cv-date">{dateRange(e)}</span>
						</div>
						{e.summary && <p class="cv-role" set:html={md(e.summary)} />}
						{e.highlights && e.highlights.length > 0 && (
							<ul class="cv-highlights">
								{e.highlights.map((h) => <li set:html={md(h)} />)}
							</ul>
						)}
					</li>
				))}
			</ul>
		</section>
	)}

	{grantsAndFunding.length > 0 && (
		<section>
			<h2>Grants &amp; funding</h2>
			<ul class="item-list">
				{grantsAndFunding.map((e) => (
					<li class="cv-entry">
						<div class="cv-entry-header">
							<strong>{e.name}</strong>
							<span class="cv-date">{dateRange(e)}</span>
						</div>
						{e.summary && <p class="cv-role" set:html={md(e.summary)} />}
						{e.highlights && e.highlights.length > 0 && (
							<ul class="cv-highlights">
								{e.highlights.map((h) => <li set:html={md(h)} />)}
							</ul>
						)}
					</li>
				))}
			</ul>
		</section>
	)}

	{publications.length > 0 && (
		<section>
			<h2>Publications</h2>
			<ul class="item-list">
				{publications.map((p) => (
					<li class="cv-entry">
						<div class="cv-entry-header">
							<strong set:html={md(p.title)} />
							<span class="cv-date">{dateRange(p)}</span>
						</div>
						<p class="cv-org">
							{(p.authors ?? []).length > 0 && (
								<span set:html={p.authors!.map((a) => md(a)).join(', ') + '. '} />
							)}
							{p.journal}
						</p>
						{p.summary && <p set:html={md(p.summary)} />}
						{p.doi && (
							<a class="doi" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">
								DOI: {p.doi}
							</a>
						)}
					</li>
				))}
			</ul>
		</section>
	)}

	{presentations.length > 0 && (
		<section>
			<h2>Selected presentations &amp; invited talks</h2>
			<ul class="item-list">
				{presentations.map((p) => (
					<li class="cv-entry">
						<p set:html={md(p.bullet)} />
					</li>
				))}
			</ul>
		</section>
	)}

	{teaching.length > 0 && (
		<section>
			<h2>Teaching &amp; program building</h2>
			<ul class="service-list wrap">
				{teaching.map((t) => (
					<li>
						<strong>{t.label}</strong>
						<span set:html={md(t.details)} />
					</li>
				))}
			</ul>
		</section>
	)}

	{professionalService.length > 0 && (
		<section>
			<h2>Professional service, governance &amp; standing</h2>
			<ul class="service-list wrap">
				{professionalService.map((s) => (
					<li>
						<strong>{s.label}</strong>
						<span set:html={md(s.details)} />
					</li>
				))}
			</ul>
		</section>
	)}

	{technicalSkills.length > 0 && (
		<section>
			<h2>Technical skills</h2>
			<div class="cv-entry">
				{technicalSkills.map((s) => (
					<p><strong>{s.label}:</strong> {s.details}</p>
				))}
			</div>
		</section>
	)}
</BaseLayout>

<style>
	.cv-header { margin-bottom: 2.5rem; padding-bottom: 1.5rem; border-bottom: 2px solid rgb(var(--gray-light)); }
	h1 { font-size: 2rem; margin-bottom: 0.25rem; }
	.cv-headline { font-size: 1.05rem; color: rgb(var(--gray-dark)); margin: 0 0 0.5rem; }
	.cv-contact { font-size: 0.9rem; color: rgb(var(--gray)); margin: 0 0 0.5rem; }
	.cv-pdf { font-size: 0.875rem; margin: 0; }
	h2 {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgb(var(--gray));
		margin: 0 0 1rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	section { margin-bottom: 2.5rem; }
	.cv-entry { margin-bottom: 1.25rem; }
	.cv-entry-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.cv-date { font-size: 0.875rem; color: rgb(var(--gray)); white-space: nowrap; flex-shrink: 0; }
	.cv-org { font-size: 0.9rem; color: rgb(var(--gray)); margin: 0.15rem 0 0.35rem; }
	.cv-role { font-size: 0.875rem; color: rgb(var(--gray)); font-style: italic; margin: 0.15rem 0 0.35rem; }
	.cv-entry p { font-size: 0.95rem; margin: 0 0 0.25rem; }
	.cv-highlights { margin: 0.35rem 0 0.25rem; padding-left: 1.1rem; }
	.cv-highlights li { font-size: 0.95rem; margin-bottom: 0.3rem; }
	.doi { font-size: 0.875rem; font-family: monospace; }
	.item-list { list-style: none; padding: 0; margin: 0; }
	.item-list .cv-entry { margin-bottom: 1.25rem; }
	.item-list .cv-entry:last-child { margin-bottom: 0; }
	.cv-highlights { list-style-type: disc; }
	.service-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
	.service-list li { padding: 0.6rem 0; border-bottom: 1px solid rgb(var(--gray-light)); font-size: 0.95rem; }
	.service-list li:last-child { border-bottom: none; }
	.service-list.wrap li { display: flex; flex-direction: column; gap: 0.2rem; }
	.service-list.wrap li strong { font-size: 0.95rem; }
	.service-list.wrap li span { color: rgb(var(--gray-dark)); }
</style>
