<style>
	footer {
		padding: 2em 1em 4em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.footer-inner {
		max-width: var(--max-w);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75em 1.5em;
	}
	.copyright {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1em;
	}
	.footer-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.footer-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.footer-links svg {
		flex-shrink: 0;
	}
</style>
