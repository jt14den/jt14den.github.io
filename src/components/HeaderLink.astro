---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	/** Extra top-level path segments (e.g. legacy URL prefixes) that should also count as active */
	activePrefixes?: string[];
};

const { href, class: className, activePrefixes = [], ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const topSegment = subpath?.[0] || '';
const isActive = href === pathname || href === '/' + topSegment || activePrefixes.includes(topSegment);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
